# Copy to .env and edit. Every value here is optional; the defaults run the
# whole pipeline offline with the NumPy + hashing fallbacks.

# ---- storage ---------------------------------------------------------------
RAG_INDEX_DIR=data/index

# ---- chunking --------------------------------------------------------------
RAG_CHUNK_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=40

# ---- embeddings ------------------------------------------------------------
# auto   = Sentence Transformers when importable, hashing fallback otherwise
# native = require Sentence Transformers (fail loudly if missing)
# fallback = always use the dependency-free hashing embedder
RAG_EMBEDDER_BACKEND=auto
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_HASHING_DIM=512

# ---- vector index ----------------------------------------------------------
RAG_USE_FAISS=true

# ---- hybrid fusion ---------------------------------------------------------
RAG_FUSION=rrf
RAG_RRF_K=60
RAG_DENSE_WEIGHT=1.0
RAG_SPARSE_WEIGHT=1.0

# ---- retrieval and reranking ----------------------------------------------
RAG_CANDIDATE_K=50
RAG_TOP_K=5
RAG_RERANK=true
# auto = cross-encoder when importable, lexical fallback otherwise
RAG_RERANKER_BACKEND=auto
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- answer generation -----------------------------------------------------
# extractive = quote retrieved sentences (no key, no cost, no hallucination risk)
# openai     = call an OpenAI-compatible chat completion with the passages
RAG_GENERATOR=extractive
OPENAI_API_KEY=
RAG_OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible gateway (vLLM, LiteLLM, Azure, Ollama).
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
